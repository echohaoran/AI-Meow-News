# Copy outside the checkout to compose.env, chmod 600, and edit before running Compose.
AI_NEWS_IMAGE=ainews-local:reviewed
AIHOT_RELEASE=reviewed
AI_NEWS_BACKEND_ENV=/absolute/path/ai-news-runtime/backend.env
AI_NEWS_DATA_DIR=/absolute/path/ai-news-runtime/data
SITE_URL=http://localhost:43180
INGRESS_BIND=127.0.0.1
# Generate independently; the same password must be URL-encoded in DATABASE_URL in backend.env.
POSTGRES_PASSWORD=
# Optional separate collector release; otherwise uses AI_NEWS_IMAGE/AIHOT_RELEASE.
# AI_NEWS_COLLECTOR_IMAGE=
# AI_NEWS_COLLECTOR_RELEASE=
