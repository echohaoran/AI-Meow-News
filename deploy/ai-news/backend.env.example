# Copy values securely into PROJECT_ROOT/.secrets/backend-production.env (0600), never source.
# Production refuses absent/placeholder values; generate with the approved secret manager.
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
ADMIN_PASSWORD=
# Optional external-ingest token: >=16 chars, never reuse the admin password.
INGEST_TOKEN=
# LLM_API_KEY may be omitted when production.env already provides OPENAI_API_KEY.
# Keep all DEV_AUTH_* absent in production.
